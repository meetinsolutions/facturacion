# Configuración Entorno de Facturación Electrónica (DGT Costa Rica)
PORT=3000

# Entorno: staging (sandbox de pruebas) o produccion
HACIENDA_ENTORNO=staging

# Credenciales generadas en el portal ATV de Hacienda
# (Si no se configuran, el sistema funcionará en modo simulación/local con firma digital)
HACIENDA_USERNAME=cpf-01-XXXX-XXXX@stag.comprobanteselectronicos.go.cr
HACIENDA_PASSWORD=mi_clave_atv

# Certificado Criptográfico .p12
CERTIFICADO_PATH=./certs/test-cert.p12
CERTIFICADO_PIN=1234

# Base de datos PostgreSQL SaaS
DATABASE_URL=postgresql://usuario:clave@127.0.0.1:5433/facturacion_saas
SSH_TUNNEL_ENABLED=false

# Seguridad y SuperAdmin
JWT_SECRET=cambiar_por_secreto_largo_aleatorio
APP_ENCRYPTION_KEY=cambiar_por_clave_hex_64_caracteres
SUPERADMIN_EMAIL=admin@tudominio.com
SUPERADMIN_PASSWORD=cambiar_clave_superadmin
PUBLIC_APP_URL=https://facturacion.tudominio.com
