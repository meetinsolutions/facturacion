# ==============================================================================
# CONFIGURACIÓN DE RESPALDOS CIFRADOS — MEETINFACT QA
# Ubicación en servidor: /etc/meetinfact-qa/backup.conf (chmod 0600)
# ==============================================================================

BACKUP_DIR="/var/backups/meetinfact-qa"
KEY_FILE="/etc/meetinfact-qa/backup.key"
DB_NAME="facturacion_test"
DB_CONTAINER="facturacion_postgres"
DB_USER="facturacion_admin"
RETENTION_DAYS=7

# Sincronización Externa S3 / Cloudflare R2 (Pendiente de credenciales del propietario)
S3_BACKUP_ENABLED=false
S3_ENDPOINT="https://<account_id>.r2.cloudflarestorage.com"
S3_BUCKET="meetinfact-qa-backups"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_REGION="auto"
